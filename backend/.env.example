# Nusxa oling: cp .env.example .env

# Sayt sarlavhasi
ORG_NAME=O'zbekiston Respublikasi Madaniyat vazirligi
SITE_TITLE=Telefon ma'lumotnomasi

# Sessiya kaliti. Bo'sh qolsa, data/secret.key avtomatik yaratiladi.
SECRET_KEY=

# Baza fayli. Standart: backend/data/telefonlar.db
# DATABASE_PATH=/opt/telefonlar/backend/data/telefonlar.db

# Sayt HTTPS orqali ochilsa 1 qiling (cookie faqat HTTPS'da yuboriladi).
COOKIE_SECURE=0
